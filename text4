-- 5c. OOH_REMOVAL_EPISODE -- one row per removal episode per child
--     Scalar episode elements here; nested repeating groups in 5d.
-- ---------------------------------------------------------------------------
CREATE OR REPLACE TABLE OOH_REMOVAL_EPISODE AS
WITH E AS (
  SELECT C.SRC_FILENAME, C.CHILD_SEQ,
         F.VALUE AS EP_XML,
         ROW_NUMBER() OVER (PARTITION BY C.CHILD_SEQ ORDER BY F.INDEX) AS EP_SEQ
  FROM OOH_CHILD_RAW C,
  LATERAL FLATTEN(INPUT => C.CHILD_XML:"$") F
  WHERE GET(F.VALUE, '@')::VARCHAR ILIKE '%removal%episode%'  -- pin from 3a
)
SELECT SRC_FILENAME, CHILD_SEQ, EP_SEQ,
  ----  >>> scalar episode columns from generator 4b <<<  ----
  -- e.g. XVAL(EP_XML, 'E69_...') AS E69_REMOVAL_NUMBER, ...
  EP_XML               -- keep: 5d flattens from this table
FROM E;

