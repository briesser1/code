-- ============================================================================
-- SECTION 2: Normalize to one row per <record>   (Tier A/B paths)
-- Handles BOTH shapes: <records> wrapper present, or <record> rows direct.
-- ============================================================================

CREATE OR REPLACE TABLE OOH_CHILD_RAW AS
-- shape 1: rows already ARE individual <record> elements
SELECT
  SRC_FILENAME,
  ROW_NUMBER() OVER (PARTITION BY SRC_FILENAME ORDER BY SEQ8()) AS CHILD_SEQ,
  X AS CHILD_XML
FROM RAW_OOH_XML
WHERE GET(X, '@')::VARCHAR ILIKE '%record'
  AND GET(X, '@')::VARCHAR NOT ILIKE '%records'

UNION ALL

-- shape 2: one <records> wrapper row -> flatten its '$' array
SELECT
  R.SRC_FILENAME,
  F.INDEX + 1 AS CHILD_SEQ,
  F.VALUE     AS CHILD_XML
FROM RAW_OOH_XML R,
LATERAL FLATTEN(INPUT => R.X:"$") F
WHERE GET(R.X, '@')::VARCHAR ILIKE '%records'
  AND IS_OBJECT(F.VALUE)
  AND GET(F.VALUE, '@')::VARCHAR ILIKE '%record';

SELECT COUNT(*) AS CHILD_RECORDS FROM OOH_CHILD_RAW;   -- sanity check

-- File header (E1 / E2 rows left over from the strip)
CREATE OR REPLACE TABLE OOH_FILE_HEADER AS
SELECT
  SRC_FILENAME,
  MAX(IFF(GET(X,'@')::VARCHAR ILIKE 'E1%', GET(X,'$')::VARCHAR, NULL)) AS E1_TITLE_IVE_AGENCY,
  MAX(IFF(GET(X,'@')::VARCHAR ILIKE 'E2%', GET(X,'$')::VARCHAR, NULL)) AS E2_REPORT_PERIOD
FROM RAW_OOH_XML
GROUP BY 1;


-- ============================================================================
-- SECTION 3: DISCOVER the schema from YOUR file (don't trust guessed tags)
-- ============================================================================

-- 3a. Every direct child tag of <record>, classified scalar vs repeating.
--     MAX_PER_RECORD > 1  ->  repeating group -> gets its own table.
CREATE OR REPLACE TEMPORARY TABLE TAG_PROFILE AS
WITH T AS (
  SELECT C.CHILD_SEQ,
         GET(F.VALUE, '@')::VARCHAR AS TAG,
         IS_ARRAY(GET(F.VALUE, '$')) AS HAS_CHILDREN
  FROM OOH_CHILD_RAW C,
  LATERAL FLATTEN(INPUT => C.CHILD_XML:"$") F
  WHERE IS_OBJECT(F.VALUE)
)
SELECT TAG,
       COUNT(*)                                   AS TOTAL_OCCURRENCES,
       COUNT(DISTINCT CHILD_SEQ)                  AS RECORDS_PRESENT,
       MAX(CNT_PER_REC)                           AS MAX_PER_RECORD,
       MAX(HAS_CHILDREN::INT)::BOOLEAN            AS IS_GROUP_ELEMENT
FROM (
  SELECT CHILD_SEQ, TAG, HAS_CHILDREN,
         COUNT(*) OVER (PARTITION BY CHILD_SEQ, TAG) AS CNT_PER_REC
  FROM T
)
GROUP BY TAG
ORDER BY TAG;

SELECT * FROM TAG_PROFILE;

