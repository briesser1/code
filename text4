
-- ============================================================================
-- AFCARS 2020 Out-of-Home Care XML -> Snowflake Relational Tables
-- Runs entirely in the Snowflake web console (Snowsight)
--
-- Hierarchy per Technical Bulletin #21 (XML File Structure & Encryption):
--   <acf:data>
--     E1 (title IV-E agency), E2 (report period)
--     <records>
--       <record>  (one per child)
--         scalar elements (E3-E68, E106-E111 ranges)
--         tribal_information group        (E7-E12,  repeating)
--         specific health conditions group (E24-E34)
--         prior adoption group             (E42-E43)
--         financial assistance group       (E47-E54, repeating)
--         siblings in foster care group    (E57-E58, repeating)
--         termination of parental rights   (E63-E68, repeating)
--         prior sex trafficking group      (E107-E108)
--         removal episode group            (E69-E105, E112-E186, REPEATING)
--           foster parent information      (E125-E135, repeating in episode)
--           permanency plan                (E147-E148, repeating in episode)
--           case worker visit              (E151-E152, repeating in episode)
--           adoptive parent information    (E157-E186, repeating in episode)
--
-- IMPORTANT: Exact XML tag names come from TB21 Appendix C / the XSD
-- (schema for the OOH file). This script DISCOVERS tag names from your
-- actual file (Section 3) and GENERATES the column lists for you
-- (Section 4), so nothing is hard-coded on guesswork.
--
-- KEY SNOWFLAKE XML FACTS (this is where naive approaches fail):
--   * Parsed XML is a VARIANT OBJECT: '@' = tag name, '$' = content.
--     For a container element, '$' is an ARRAY of child objects.
--     For a leaf element, '$' is the text/number value.
--   * FLATTEN(PATH => 'a.b') does NOT work on XML the way it does on
--     JSON. You must FLATTEN(input => x:"$") and filter GET(value,'@').
--   * XMLGET(x, 'tag') returns the FIRST matching child. Fine for
--     singletons; for repeating groups use the flatten+filter pattern.
--   * VARIANT row limit: 16MB classic, 128MB if your account has the
--     increased max object size enabled. A whole state OOH file will
--     usually NOT fit as one row -> see Section 1 loading tiers.
-- ============================================================================


-- ============================================================================
-- SECTION 0: Environment
-- ============================================================================
-- Pick your database/schema first, e.g.:
-- USE DATABASE MY_DB; USE SCHEMA AFCARS;

CREATE STAGE IF NOT EXISTS AFCARS_XML_STAGE;

-- Upload the file in Snowsight:
--   Data > Databases > (your schema) > Stages > AFCARS_XML_STAGE > + Files
-- Then confirm:
LIST @AFCARS_XML_STAGE;

-- Helper UDF: extract text of a singleton child element
CREATE OR REPLACE FUNCTION XVAL(X VARIANT, TAG VARCHAR)
RETURNS VARCHAR
AS
$$
  GET(XMLGET(X, TAG), '$')::VARCHAR
$$;


-- ============================================================================
-- SECTION 1: Load raw XML  (three tiers by file size)
-- ============================================================================

CREATE OR REPLACE TABLE RAW_OOH_XML (
  SRC_FILENAME  VARCHAR,
  LOAD_TS       TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
  X             VARIANT        -- one XML fragment per row
);

-- ---------------------------------------------------------------------------
-- TIER A: file fits in one VARIANT row (small test files)
-- ---------------------------------------------------------------------------
-- COPY INTO RAW_OOH_XML (SRC_FILENAME, X)
-- FROM (SELECT METADATA$FILENAME, $1 FROM @AFCARS_XML_STAGE)
-- FILE_FORMAT = (TYPE = XML STRIP_OUTER_ELEMENT = FALSE);

-- ---------------------------------------------------------------------------
-- TIER B (most common): strip the <acf:data> root so each direct child
-- becomes its own row (E1 row, E2 row, and the <records> row or, if your
-- state omits the wrapper, one row per <record>).
-- ---------------------------------------------------------------------------
COPY INTO RAW_OOH_XML (SRC_FILENAME, X)
FROM (SELECT METADATA$FILENAME, $1 FROM @AFCARS_XML_STAGE)
FILE_FORMAT = (TYPE = XML STRIP_OUTER_ELEMENT = TRUE)
ON_ERROR = 'ABORT_STATEMENT';

-- See what landed (expect tags like: E1_..., E2_..., records / record)
SELECT GET(X, '@')::VARCHAR AS TAG, COUNT(*) AS N
FROM RAW_OOH_XML
GROUP BY 1;

