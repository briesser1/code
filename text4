-- Concrete example -- tribal information:
CREATE OR REPLACE TABLE OOH_TRIBAL_INFO AS
WITH G AS (
  SELECT C.SRC_FILENAME, C.CHILD_SEQ,
         F.VALUE AS GRP_XML,
         ROW_NUMBER() OVER (PARTITION BY C.CHILD_SEQ ORDER BY F.INDEX) AS GRP_SEQ
  FROM OOH_CHILD_RAW C,
  LATERAL FLATTEN(INPUT => C.CHILD_XML:"$") F
  WHERE GET(F.VALUE, '@')::VARCHAR ILIKE '%tribal%'   -- pin exact tag from 3a
)
SELECT SRC_FILENAME, CHILD_SEQ, GRP_SEQ,
  ----  >>> columns from generator 4b for the tribal group <<<  ----
  GRP_XML
FROM G;

