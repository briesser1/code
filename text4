-- 4a. Column list for the CHILD table (scalar, non-group tags only).
--     Run, copy the single output cell, paste into Section 5a.
SELECT LISTAGG(
         '  XVAL(CHILD_XML, ''' || TAG || ''') AS ' || UPPER(TAG),
         ',\n'
       ) WITHIN GROUP (ORDER BY TAG) AS CHILD_SELECT_LIST
FROM TAG_PROFILE
WHERE MAX_PER_RECORD = 1 AND NOT IS_GROUP_ELEMENT;

