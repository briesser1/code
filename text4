
-- ============================================================================
-- AFCARS 2020 XML INGESTION — STREAMING (SNOWFLAKE WORKSHEET, self-contained)
-- ----------------------------------------------------------------------------
-- Approach: a Python stored procedure streams the staged XML file with
-- xml.etree.ElementTree.iterparse — one <record> subtree in memory at a time,
-- cleared after processing, rows batched into normalized bronze tables.
-- Handles files far beyond Snowflake's VARIANT size cap.
--
-- Design (medallion-friendly):
--   RAW    : staged XML + loader procedure
--   BRONZE : normalized-grain tables. Keys are explicit columns; all element
--            values land in an ATTRS VARIANT keyed by the XSD tag name
--            (UPPERCASED). This avoids hand-enumerating ~186 elements and
--            lets silver views/dbt do typing per element.
--   SILVER : typed views (one example included; pattern repeats)
--
-- Grain / tables (11):
--   SUBMISSION              1 row per file          (E1, E2)
--   CHILD                   1 row per <record>      (E4..E68 scalars, E106..E110)
--   CHILD_TRIBE             child x tribe           (E9, repeating)
--   TPR_SECOND_PARENT       child x 2nd parent      (E64, E66, E68, repeating)
--   TRAFFICKING_REPORT_DATE child x report date     (E108 / E111, repeating)
--   REMOVAL                 child x removal episode (removal_1993 | removal_2020;
--                                                    E69..E105, E153..E156,
--                                                    adoptive parents E157..E186 hoisted)
--   LIVING_ARRANGEMENT      removal x placement     (E112..E122; foster home type
--                                                    + foster parents E123..E146 hoisted)
--   PERMANENCY_PLAN         removal x plan          (E147, E148)
--   PERIODIC_REVIEW         removal x review date   (E149)
--   PERMANENCY_HEARING      removal x hearing date  (E150)
--   CASE_WORKER_VISIT       removal x visit         (E151, E152)
--
-- 1:1 wrapper groups (tribal_information, specific_health_conditions,
-- type_financial_assistance, siblings_in_foster_care, prior_adoption,
-- tpr_first_parent, foster/adoptive parent blocks) are HOISTED into their
-- parent row's ATTRS — element names are globally unique in the XSD, so no
-- collisions occur.
-- ============================================================================


-- ============================================================================
-- PART 0 — CONTEXT, STAGE, DDL
-- ============================================================================
CREATE DATABASE IF NOT EXISTS AFCARS;
CREATE SCHEMA IF NOT EXISTS AFCARS.RAW;
CREATE SCHEMA IF NOT EXISTS AFCARS.BRONZE;
CREATE SCHEMA IF NOT EXISTS AFCARS.SILVER;

-- Internal stage; DIRECTORY enables BUILD_SCOPED_FILE_URL for the Python proc.
CREATE STAGE IF NOT EXISTS AFCARS.RAW.XML_STAGE
  DIRECTORY = (ENABLE = TRUE)
  ENCRYPTION = (TYPE = 'SNOWFLAKE_SSE');

-- Upload the file in Snowsight: Data > Databases > AFCARS.RAW > Stages >
-- XML_STAGE > "+ Files"  (or PUT via SnowSQL). Then:
ALTER STAGE AFCARS.RAW.XML_STAGE REFRESH;

-- ---------------------------------------------------------------------------
-- Bronze DDL
-- ---------------------------------------------------------------------------
CREATE OR REPLACE TABLE AFCARS.BRONZE.SUBMISSION (
  FILE_NAME        STRING,
  TITLE_IV_AGENCY  STRING,          -- E1
  REPORT_PERIOD    STRING,          -- E2 (yyyymm)
  LOADED_AT        TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.CHILD (
  FILE_NAME            STRING,
  CHILD_RECORD_NUMBER  STRING,      -- E4
  PREVIOUS_ID          STRING,      -- E4/@previous_id
  ATTRS                VARIANT      -- all 1:1 child-level elements
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.CHILD_TRIBE (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING,
  TRIBE_SEQ NUMBER, TRIBE_CODE STRING                      -- E9
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.TPR_SECOND_PARENT (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING, PARENT_SEQ NUMBER,
  E64_TPR_PARENT2 STRING, E66_TPR_PETITION_DATE_PARENT2 STRING,
  E68_TPR_DATE_PARENT2 STRING
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.TRAFFICKING_REPORT_DATE (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING,
  REPORT_TYPE STRING,               -- 'PRIOR' (E108) | 'CURRENT' (E111)
  REPORT_SEQ NUMBER, REPORTED_DATE STRING
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.REMOVAL (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING,
  REMOVAL_SEQ NUMBER,               -- order within <E69_E186_removals>
  REMOVAL_SCHEMA STRING,            -- '1993' | '2020'
  ATTRS VARIANT                     -- E69..E105, E153..E156, E157..E186
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.LIVING_ARRANGEMENT (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING, REMOVAL_SEQ NUMBER,
  ARRANGEMENT_SEQ NUMBER,
  ATTRS VARIANT                     -- E112..E146 (foster parents hoisted)
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.PERMANENCY_PLAN (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING, REMOVAL_SEQ NUMBER,
  PLAN_SEQ NUMBER, PLAN_DATE STRING, PLAN_TYPE STRING      -- E147, E148
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.PERIODIC_REVIEW (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING, REMOVAL_SEQ NUMBER,
  REVIEW_SEQ NUMBER, REVIEW_DATE STRING                    -- E149
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.PERMANENCY_HEARING (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING, REMOVAL_SEQ NUMBER,
  HEARING_SEQ NUMBER, HEARING_DATE STRING                  -- E150
);

CREATE OR REPLACE TABLE AFCARS.BRONZE.CASE_WORKER_VISIT (
  FILE_NAME STRING, CHILD_RECORD_NUMBER STRING, REMOVAL_SEQ NUMBER,
  VISIT_SEQ NUMBER, VISIT_DATE STRING, VISIT_LOCATION STRING  -- E151, E152
);


-- ============================================================================
-- PART 1 — STREAMING PYTHON STORED PROCEDURE
-- ============================================================================
-- Re-running for the same FILE_NAME is idempotent (delete-then-load).
-- Note: single-node/single-thread — for very large national files, split the
-- <records> block into shards and CALL once per shard for parallelism.

CREATE OR REPLACE PROCEDURE AFCARS.RAW.LOAD_AFCARS_XML(
  STAGE_URL     STRING,   -- pass BUILD_SCOPED_FILE_URL(@stage,'file.xml')
  FILE_NAME     STRING,
  TARGET_SCHEMA STRING,   -- e.g. 'AFCARS.BRONZE'
  BATCH_SIZE    NUMBER    -- child records per flush; 1000 is a good default
)
RETURNS STRING
LANGUAGE PYTHON
RUNTIME_VERSION = '3.11'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'main'
AS
$$
import json
import xml.etree.ElementTree as ET
from snowflake.snowpark.files import SnowflakeFile
from snowflake.snowpark.functions import parse_json, col

def ln(tag):                       # local name (strip any namespace)
    return tag.rsplit('}', 1)[-1]

def txt(e):
    s = (e.text or '').strip()
    return s if s else None

def descendants(elem, name):       # all descendants with a given local name
    return [e for e in elem.iter() if ln(e.tag) == name]

def hoist(elem, block=frozenset(), out=None):
    """Recursively flatten 1:1 element groups into one dict keyed by
    UPPERCASED tag name; `block` names branches handled as child tables."""
    if out is None:
        out = {}
    for ch in elem:
        t = ln(ch.tag)
        if t in block:
            continue
        if len(ch) == 0:
            out[t.upper()] = txt(ch)
        else:
            hoist(ch, block, out)
    return out

# Branches at child level that are NOT 1:1 (loaded to their own tables)
CHILD_BLOCK = frozenset({
    'E69_E186_removals',
    'E9_recognized_tribes',
    'tpr_second_parent',
    'E108_prior_victim_sex_trafficking_reported_date',
    'E111_victim_sex_trafficking_reported_date',
})
# Branches at removal level that are NOT 1:1
REMOVAL_BLOCK = frozenset({
    'E112_E146_living_arrangements',
    'E147_E148_permanency_plans',
    'E149_periodic_reviews',
    'E150_permanency_hearings',
    'E151_E152_case_worker_visits',
})

def handle_record(rec, fn, add):
    """Decompose one <record> subtree into rows for all 10 child tables."""
    e4 = next(iter(descendants(rec, 'E4_child_record_number')), None)
    child_no = txt(e4) if e4 is not None else None
    prev_id  = e4.get('previous_id') if e4 is not None else None

    add('CHILD', (fn, child_no, prev_id, json.dumps(hoist(rec, CHILD_BLOCK))))

    for i, t in enumerate(descendants(rec, 'E9_recognized_tribe'), 1):
        add('CHILD_TRIBE', (fn, child_no, i, txt(t)))

    for i, p in enumerate(descendants(rec, 'tpr_second_parent'), 1):
        d = hoist(p)
        add('TPR_SECOND_PARENT', (fn, child_no, i,
            d.get('E64_TPR_PARENT2'),
            d.get('E66_TPR_PETITION_DATE_PARENT2'),
            d.get('E68_TPR_DATE_PARENT2')))

    for typ, tag in (('PRIOR',   'E108_prior_victim_sex_trafficking_reported_date'),
                     ('CURRENT', 'E111_victim_sex_trafficking_reported_date')):
        for i, dte in enumerate(descendants(rec, tag), 1):
            add('TRAFFICKING_REPORT_DATE', (fn, child_no, typ, i, txt(dte)))

    removals = next(iter(descendants(rec, 'E69_E186_removals')), None)
    if removals is None:
        return
    seq = 0
    for rmv in removals:
        kind = ln(rmv.tag)
        if kind not in ('removal_1993', 'removal_2020'):
            continue
        seq += 1
        add('REMOVAL', (fn, child_no, seq, kind[-4:],
                        json.dumps(hoist(rmv, REMOVAL_BLOCK))))

        for i, la in enumerate(descendants(rmv, 'living_arrangement'), 1):
            add('LIVING_ARRANGEMENT', (fn, child_no, seq, i, json.dumps(hoist(la))))

        for i, pp in enumerate(descendants(rmv, 'permanency_plan'), 1):
            d = hoist(pp)
            add('PERMANENCY_PLAN', (fn, child_no, seq, i,
                d.get('E147_PERMANENCY_PLAN_DATE'), d.get('E148_PERMANENCY_PLAN_TYPE')))

        for i, rv in enumerate(descendants(rmv, 'E149_periodic_review_date'), 1):
            add('PERIODIC_REVIEW', (fn, child_no, seq, i, txt(rv)))

        for i, h in enumerate(descendants(rmv, 'E150_permanency_hearing_date'), 1):
            add('PERMANENCY_HEARING', (fn, child_no, seq, i, txt(h)))

        for i, v in enumerate(descendants(rmv, 'case_worker_visit'), 1):
            d = hoist(v)
            add('CASE_WORKER_VISIT', (fn, child_no, seq, i,
                d.get('E151_CASE_WORKER_VISIT_DATE'),
                d.get('E152_CASE_WORKER_VISIT_LOCATION')))

def main(session, stage_url, file_name, target_schema, batch_size):
    batch_size = int(batch_size or 1000)

    # (table) -> (columns, row buffer, variant column to PARSE_JSON, or None)
    T = {
        'CHILD': (['FILE_NAME','CHILD_RECORD_NUMBER','PREVIOUS_ID','ATTRS'], [], 'ATTRS'),
        'CHILD_TRIBE': (['FILE_NAME','CHILD_RECORD_NUMBER','TRIBE_SEQ','TRIBE_CODE'], [], None),
        'TPR_SECOND_PARENT': (['FILE_NAME','CHILD_RECORD_NUMBER','PARENT_SEQ',
                               'E64_TPR_PARENT2','E66_TPR_PETITION_DATE_PARENT2',
                               'E68_TPR_DATE_PARENT2'], [], None),
        'TRAFFICKING_REPORT_DATE': (['FILE_NAME','CHILD_RECORD_NUMBER','REPORT_TYPE',
                                     'REPORT_SEQ','REPORTED_DATE'], [], None),
        'REMOVAL': (['FILE_NAME','CHILD_RECORD_NUMBER','REMOVAL_SEQ',
                     'REMOVAL_SCHEMA','ATTRS'], [], 'ATTRS'),
        'LIVING_ARRANGEMENT': (['FILE_NAME','CHILD_RECORD_NUMBER','REMOVAL_SEQ',
                                'ARRANGEMENT_SEQ','ATTRS'], [], 'ATTRS'),
        'PERMANENCY_PLAN': (['FILE_NAME','CHILD_RECORD_NUMBER','REMOVAL_SEQ',
                             'PLAN_SEQ','PLAN_DATE','PLAN_TYPE'], [], None),
        'PERIODIC_REVIEW': (['FILE_NAME','CHILD_RECORD_NUMBER','REMOVAL_SEQ',
                             'REVIEW_SEQ','REVIEW_DATE'], [], None),
        'PERMANENCY_HEARING': (['FILE_NAME','CHILD_RECORD_NUMBER','REMOVAL_SEQ',
                                'HEARING_SEQ','HEARING_DATE'], [], None),
        'CASE_WORKER_VISIT': (['FILE_NAME','CHILD_RECORD_NUMBER','REMOVAL_SEQ',
                               'VISIT_SEQ','VISIT_DATE','VISIT_LOCATION'], [], None),
    }

    def add(t, row):
        T[t][1].append(row)

    def flush():
        for t, (cols, rows, vc) in T.items():
            if not rows:
                continue
            df = session.create_dataframe(rows, schema=cols)
            if vc:
                df = df.with_column(vc, parse_json(col(vc)))
            df.write.mode('append').save_as_table(f'{target_schema}.{t}')
            rows.clear()

    # idempotent re-load for this file
    fq = file_name.replace("'", "''")
    for t in list(T) + ['SUBMISSION']:
        session.sql(
            f"DELETE FROM {target_schema}.{t} WHERE FILE_NAME = '{fq}'"
        ).collect()

    agency = period = None
    n = 0
    with SnowflakeFile.open(stage_url, 'rb') as f:
        it = ET.iterparse(f, events=('start', 'end'))
        _, root = next(it)                    # <data>
        for ev, elem in it:
            if ev != 'end':
                continue
            tag = ln(elem.tag)
            if tag == 'E1_title_iv_agency':
                agency = txt(elem)
            elif tag == 'E2_report_date':
                period = txt(elem)
            elif tag == 'record':
                handle_record(elem, file_name, add)
                n += 1
                elem.clear()                  # bound memory
                if n % batch_size == 0:
                    flush()
            elif tag == 'records':
                elem.clear()
    flush()

    session.sql(
        f"INSERT INTO {target_schema}.SUBMISSION (FILE_NAME, TITLE_IV_AGENCY, REPORT_PERIOD) "
        f"VALUES ('{fq}', "
        f"{'NULL' if agency is None else chr(39)+agency.replace(chr(39),chr(39)*2)+chr(39)}, "
        f"{'NULL' if period is None else chr(39)+period.replace(chr(39),chr(39)*2)+chr(39)})"
    ).collect()

    return f'Loaded {n} child records from {file_name}'
$$;

-- Invocation:
CALL AFCARS.RAW.LOAD_AFCARS_XML(
  BUILD_SCOPED_FILE_URL(@AFCARS.RAW.XML_STAGE, 'afcars_submission.xml'),
  'afcars_submission.xml',
  'AFCARS.BRONZE',
  1000
);


-- ============================================================================
-- PART 2 — SILVER TYPING PATTERN + VALIDATION
-- ============================================================================
-- One example typed view; the pattern repeats per table/element (ideal dbt
-- model territory). Dates are yyyymmdd / yyyymm strings per the XSD.
CREATE OR REPLACE VIEW AFCARS.SILVER.CHILD AS
SELECT
  FILE_NAME,
  CHILD_RECORD_NUMBER,
  PREVIOUS_ID,
  TRY_TO_DATE(ATTRS:E5_DATE_OF_BIRTH::STRING, 'YYYYMMDD')      AS DATE_OF_BIRTH,
  ATTRS:E6_SEX::STRING                                          AS SEX,
  ATTRS:E13_CHILD_RACE_AMERICAN_INDIAN_ALASKA_NATIVE::STRING    AS RACE_AIAN,
  ATTRS:E21_CHILD_HISPANIC_LATINO::STRING                       AS HISPANIC_LATINO,
  ATTRS:E35_SCHOOL_ENROLLMENT::STRING                           AS SCHOOL_ENROLLMENT,
  ATTRS:E63_TPR_PARENT1::STRING                                 AS TPR_PARENT1,
  TRY_TO_DATE(ATTRS:E67_TPR_DATE_PARENT1::STRING, 'YYYYMMDD')   AS TPR_DATE_PARENT1,
  ATTRS                                                         AS ATTRS   -- keep full payload
FROM AFCARS.BRONZE.CHILD;

-- Row counts by table
SELECT 'CHILD' T, COUNT(*) N FROM AFCARS.BRONZE.CHILD
UNION ALL SELECT 'REMOVAL', COUNT(*) FROM AFCARS.BRONZE.REMOVAL
UNION ALL SELECT 'LIVING_ARRANGEMENT', COUNT(*) FROM AFCARS.BRONZE.LIVING_ARRANGEMENT
UNION ALL SELECT 'PERMANENCY_PLAN', COUNT(*) FROM AFCARS.BRONZE.PERMANENCY_PLAN
UNION ALL SELECT 'PERIODIC_REVIEW', COUNT(*) FROM AFCARS.BRONZE.PERIODIC_REVIEW
UNION ALL SELECT 'PERMANENCY_HEARING', COUNT(*) FROM AFCARS.BRONZE.PERMANENCY_HEARING
UNION ALL SELECT 'CASE_WORKER_VISIT', COUNT(*) FROM AFCARS.BRONZE.CASE_WORKER_VISIT
UNION ALL SELECT 'CHILD_TRIBE', COUNT(*) FROM AFCARS.BRONZE.CHILD_TRIBE
UNION ALL SELECT 'TPR_SECOND_PARENT', COUNT(*) FROM AFCARS.BRONZE.TPR_SECOND_PARENT
UNION ALL SELECT 'TRAFFICKING_REPORT_DATE', COUNT(*) FROM AFCARS.BRONZE.TRAFFICKING_REPORT_DATE;

-- Referential sanity: removals with no parent child row (expect 0)
SELECT COUNT(*) AS ORPHAN_REMOVALS
FROM AFCARS.BRONZE.REMOVAL r
LEFT JOIN AFCARS.BRONZE.CHILD c
  ON c.FILE_NAME = r.FILE_NAME AND c.CHILD_RECORD_NUMBER = r.CHILD_RECORD_NUMBER
WHERE c.CHILD_RECORD_NUMBER IS NULL;

-- Duplicate child keys within a file (expect 0)
SELECT FILE_NAME, CHILD_RECORD_NUMBER, COUNT(*)
FROM AFCARS.BRONZE.CHILD
GROUP BY 1, 2 HAVING COUNT(*) > 1;

-- Spot-check ATTRS coverage (element keys present per child)
SELECT CHILD_RECORD_NUMBER, ARRAY_SIZE(OBJECT_KEYS(ATTRS)) AS N_ELEMENTS
FROM AFCARS.BRONZE.CHILD LIMIT 20;

-- ============================================================================
-- OPERATIONAL NOTES
-- 1. Re-running the proc for the same FILE_NAME is safe: it deletes that
--    file's rows from all tables before loading.
-- 2. The proc is single-threaded. Throughput is roughly linear in file size;
--    warehouse size barely matters for the parse itself (only the batched
--    inserts). For very large national files, pre-split <records> into
--    shards and CALL per shard, or raise BATCH_SIZE to reduce insert
--    round-trips. lxml (available in the Snowflake Anaconda channel) is a
--    drop-in iterparse replacement if ET proves slow.
-- 3. All bronze values are strings by design (the XSD types everything as
--    restricted strings, including dates). Typing belongs in silver.
-- 4. Namespaces are a non-issue: ln() strips any {namespace} prefix, so the
--    loader works whether or not the instance file declares xmlns.
-- 5. BUILD_SCOPED_FILE_URL requires the DIRECTORY-enabled stage above and
--    that the caller has USAGE/READ on the stage.
-- ============================================================================
