"""
US States + Territories composite map for Power BI Shape Map
-------------------------------------------------------------
Real boundary shapes (Natural Earth data), stylized layout:
  - Lower 48 + DC in a proper Albers equal-area projection
  - Alaska, Hawaii, and all five territories repositioned as
    enlarged insets in a strip along the bottom
Output: us_composite.topojson (screen coords, y-down, like us-atlas)
Requires: pyshp, shapely.
"""

import json, math, os, urllib.request
import shapefile
from shapely.geometry import shape, MultiPolygon
from shapely.ops import transform as shp_transform

# ---------------- 0. Download Natural Earth data (once, cached) ---------------- #
NE = "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master"
SOURCES = {
    "states": f"{NE}/50m_cultural/ne_50m_admin_1_states_provinces",
    "units":  f"{NE}/10m_cultural/ne_10m_admin_0_map_units",
}
os.makedirs("data", exist_ok=True)
for base, url in SOURCES.items():
    for ext in ("shp", "shx", "dbf"):
        dest = f"data/{base}.{ext}"
        if not os.path.exists(dest):
            print(f"Downloading {dest} ...")
            urllib.request.urlretrieve(f"{url}.{ext}", dest)

# ---------------- Albers equal-area conic (spherical) ---------------- #
def albers(lon0, lat0, sp1, sp2):
    p1, p2, l0, f0 = map(math.radians, (sp1, sp2, lon0, lat0))
    n = (math.sin(p1) + math.sin(p2)) / 2.0
    C = math.cos(p1) ** 2 + 2 * n * math.sin(p1)
    rho0 = math.sqrt(C - 2 * n * math.sin(f0)) / n
    def project(lon, lat):
        lam, phi = math.radians(lon), math.radians(lat)
        rho = math.sqrt(max(C - 2 * n * math.sin(phi), 0)) / n
        th = n * (lam - l0)
        # y negated -> screen coords (north = up = smaller y)
        return rho * math.sin(th), -(rho0 - rho * math.cos(th))
    return project

def project_geom(geom, proj, wrap_lon=False):
    def fn(x, y, z=None):
        if wrap_lon and x > 0:
            x -= 360.0
        return proj(x, y)
    return shp_transform(fn, geom)

def crop_lonlat(geom, lon_min=-360, lon_max=360, lat_min=-90, lat_max=90):
    """Keep polygon parts whose centroid falls in the lon/lat window."""
    parts = list(geom.geoms) if isinstance(geom, MultiPolygon) else [geom]
    kept = [p for p in parts
            if lon_min <= p.centroid.x <= lon_max and lat_min <= p.centroid.y <= lat_max]
    if not kept:
        kept = [max(parts, key=lambda p: p.area)]
    return MultiPolygon(kept) if len(kept) > 1 else kept[0]

def fit(geom_map, box_w, box_h):
    minx = min(g.bounds[0] for g in geom_map.values())
    miny = min(g.bounds[1] for g in geom_map.values())
    maxx = max(g.bounds[2] for g in geom_map.values())
    maxy = max(g.bounds[3] for g in geom_map.values())
    s = min(box_w / (maxx - minx), box_h / (maxy - miny))
    fn = lambda x, y, z=None: ((x - minx) * s, (y - miny) * s)
    out = {k: shp_transform(fn, g) for k, g in geom_map.items()}
    return out, (maxx - minx) * s, (maxy - miny) * s

def translate(geom_map, dx, dy):
    return {k: shp_transform(lambda x, y, z=None: (x + dx, y + dy), g)
            for k, g in geom_map.items()}

def clean(geom, simplify_tol, min_ring_area):
    geom = geom.simplify(simplify_tol, preserve_topology=True)
    if geom.is_empty:
        return None
    polys = list(geom.geoms) if isinstance(geom, MultiPolygon) else [geom]
    polys = [p for p in polys if not p.is_empty]
    if not polys:
        return None
    biggest = max(polys, key=lambda p: p.area)
    kept = [p for p in polys if p.area >= min_ring_area]
    if biggest not in kept:
        kept.append(biggest)
    return MultiPolygon(kept) if len(kept) > 1 else kept[0]

# ---------------- 1. Load real shapes ---------------- #
states_raw = {}
for sr in shapefile.Reader("data/states").shapeRecords():
    rec = sr.record
    if rec["adm0_a3"] != "USA":
        continue
    fips = rec["fips"].replace("US", "") if rec["fips"] else ""
    states_raw[rec["postal"]] = (rec["name"], fips, shape(sr.shape.__geo_interface__))

TERR = {"PRI": ("PR", "Puerto Rico", "72"),
        "VIR": ("VI", "U.S. Virgin Islands", "78"),
        "GUM": ("GU", "Guam", "66"),
        "ASM": ("AS", "American Samoa", "60"),
        "MNP": ("MP", "Northern Mariana Islands", "69")}
terr_raw = {}
for sr in shapefile.Reader("data/units").shapeRecords():
    code = sr.record["ADM0_A3"]
    if code in TERR:
        abbr, name, fips = TERR[code]
        terr_raw[abbr] = (name, fips, shape(sr.shape.__geo_interface__))

# Crop away remote uninhabited outliers so main islands read large
states_raw["HI"] = (*states_raw["HI"][:2],
                    crop_lonlat(states_raw["HI"][2], lon_min=-161.0))          # main 8 islands
terr_raw["AS"] = (*terr_raw["AS"][:2],
                  crop_lonlat(terr_raw["AS"][2], lon_min=-171.0, lon_max=-169.0))  # Tutuila + Manu'a
terr_raw["MP"] = (*terr_raw["MP"][:2],
                  crop_lonlat(terr_raw["MP"][2], lat_max=15.6))                # Saipan/Tinian/Rota

# ---------------- 2. Project each group ---------------- #
P = {
    "CONUS": albers(-96, 37.5, 29.5, 45.5),
    "AK": albers(-152, 60, 55, 65),
    "HI": albers(-157, 20.5, 19, 21.5),
    "PR": albers(-66.4, 18.2, 18, 18.4),
    "VI": albers(-64.8, 18.0, 17.8, 18.3),
    "GU": albers(144.8, 13.4, 13.2, 13.6),
    "AS": albers(-170.3, -14.3, -14.5, -14.1),
    "MP": albers(145.4, 14.9, 14.1, 15.6),
}
conus = {a: project_geom(g, P["CONUS"])
         for a, (_, _, g) in states_raw.items() if a not in ("AK", "HI")}
insets_raw = {k: project_geom((states_raw if k in ("AK", "HI") else terr_raw)[k][2],
                              P[k], wrap_lon=(k == "AK"))
              for k in ("AK", "HI", "AS", "GU", "MP", "PR", "VI")}

# ---------------- 3. Layout ---------------- #
W = 975.0
conus, cw, ch = fit(conus, W, 610)
conus = translate(conus, (W - cw) / 2, 0)
MAIN_H = ch

STRIP_TOP = MAIN_H + 22
STRIP_H = 145.0

# per-inset: (target_w, target_h, speck_area, simplify_tol) — sizes chosen to look nice
strip_spec = [
    ("AK", 250, STRIP_H, 6.0, 1.0),
    ("HI", 135, 100, 0.8, 0.5),
    ("AS", 95, 75, 0.5, 0.4),
    ("GU", 55, 95, 0.5, 0.4),
    ("MP", 70, STRIP_H, 0.8, 0.5),
    ("PR", 155, 90, 1.5, 0.5),
    ("VI", 100, 75, 0.5, 0.4),
]
GAP_X = 24.0
placed, x = {}, 6.0
for key, mw, mh, speck, tol in strip_spec:
    # normalize -> clean specks -> refit so the surviving islands fill the box
    work, _, _ = fit({key: insets_raw[key]}, 400, 400)
    g = clean(work[key], 400 / max(mw, mh) * tol, speck * (400 / max(mw, mh)) ** 2)
    fitted, w, h = fit({key: g}, mw, mh)
    placed.update(translate(fitted, x, STRIP_TOP + (STRIP_H - h) / 2))
    x += w + GAP_X

TOTAL_H = STRIP_TOP + STRIP_H + 6
all_geoms = {**conus, **placed}

# ---------------- 4. Clean mainland states ---------------- #
final = {}
for abbr, g in all_geoms.items():
    if abbr in placed:
        g = clean(g, 0.0001, 0)          # already cleaned pre-fit
    else:
        g = clean(g, 0.9, 4.0)
    if g is not None and not g.is_empty:
        final[abbr] = g

# ---------------- 5. Emit TopoJSON ---------------- #
META = {a: (n, f) for a, (n, f, _) in states_raw.items()}
META.update({a: (n, f) for _, (a, n, f) in TERR.items()})

arcs, geometries = [], []
for abbr in sorted(final):
    g = final[abbr]
    polys = list(g.geoms) if isinstance(g, MultiPolygon) else [g]
    poly_arcs = []
    for p in polys:
        ring_idx = []
        for ring in [p.exterior, *p.interiors]:
            arcs.append([[round(cx, 2), round(cy, 2)] for cx, cy in ring.coords])
            ring_idx.append(len(arcs) - 1)
        poly_arcs.append(ring_idx)
    name, fips = META[abbr]
    geometries.append({
        "type": "MultiPolygon" if len(poly_arcs) > 1 else "Polygon",
        "arcs": poly_arcs if len(poly_arcs) > 1 else poly_arcs[0],
        "id": abbr,
        "properties": {"name": name, "abbr": abbr, "fips": fips, "iso": f"US-{abbr}"},
    })

topo = {"type": "Topology",
        "objects": {"states": {"type": "GeometryCollection", "geometries": geometries}},
        "arcs": arcs,
        "bbox": [0, 0, W, TOTAL_H]}

with open("us_composite.topojson", "w") as f:
    json.dump(topo, f, separators=(",", ":"))
print(f"Wrote us_composite.topojson: {len(geometries)} regions, "
      f"{sum(len(a) for a in arcs)} points, canvas {W:.0f}x{TOTAL_H:.0f}")

