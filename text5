<title>Formbundle</title>
<style>
  @font-face {
    font-family: 'FB Serif';
    src: local('Source Serif 4'), local('Georgia');
  }

  :root {
    --ink: #1C2127;
    --paper: #F6F4EF;
    --paper-raised: #FDFCF9;
    --accent: #5B7A6B;
    --accent-ink: #3E5A4D;
    --alert: #C9452E;
    --stone: #D8D3C4;
    --stone-soft: #E7E3D8;
    --grey: #8A8578;
    --grey-soft: #B6B0A0;
    --shadow: rgba(28, 33, 39, 0.08);
    --focus-ring: #5B7A6B;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ink: #EDEAE2;
      --paper: #15181C;
      --paper-raised: #1C2127;
      --accent: #7FA18F;
      --accent-ink: #9DBBAC;
      --alert: #E07059;
      --stone: #343C40;
      --stone-soft: #262C30;
      --grey: #8E9490;
      --grey-soft: #5C6360;
      --shadow: rgba(0, 0, 0, 0.35);
      --focus-ring: #7FA18F;
    }
  }

  :root[data-theme="dark"] {
    --ink: #EDEAE2;
    --paper: #15181C;
    --paper-raised: #1C2127;
    --accent: #7FA18F;
    --accent-ink: #9DBBAC;
    --alert: #E07059;
    --stone: #343C40;
    --stone-soft: #262C30;
    --grey: #8E9490;
    --grey-soft: #5C6360;
    --shadow: rgba(0, 0, 0, 0.35);
    --focus-ring: #7FA18F;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'FB Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: 'FB Serif', 'Source Serif 4', Georgia, serif;
    text-wrap: balance;
    margin: 0;
    font-weight: 600;
  }

  code, .mono {
    font-family: 'SF Mono', 'IBM Plex Mono', Menlo, Consolas, monospace;
  }

  button {
    font-family: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* ---------- Shell ---------- */

  .shell {
    max-width: 920px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--stone);
    margin-bottom: 2rem;
  }

  .masthead .brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .masthead .brand .mark {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    font-family: 'FB Serif', Georgia, serif;
    font-size: 1rem;
    font-weight: 700;
    transform: translateY(2px);
  }

  .masthead h1 {
    font-size: 1.3rem;
    letter-spacing: 0.01em;
  }

  .masthead .tag {
    font-size: 0.75rem;
    color: var(--grey);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ---------- Stepper ---------- */

  .stepper {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2.25rem;
  }

  .step {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--stone);
    border-radius: 7px;
    background: var(--paper-raised);
    color: var(--grey);
    font-size: 0.82rem;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .step .num {
    font-family: 'FB Serif', Georgia, serif;
    font-weight: 700;
    font-size: 0.95rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid var(--grey-soft);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .step.active {
    border-color: var(--accent);
    color: var(--ink);
    background: var(--paper-raised);
  }
  .step.active .num {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper-raised);
  }

  .step.done {
    color: var(--accent-ink);
  }
  .step.done .num {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .step .label strong {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .step .label span { display: none; }
    .stepper { gap: 0.4rem; }
  }

  /* ---------- Pages ---------- */

  .page { display: none; }
  .page.active { display: block; animation: rise 0.25s ease; }

  @media (prefers-reduced-motion: reduce) {
    .page.active { animation: none; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .intro {
    margin-bottom: 1.75rem;
  }
  .intro h2 {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
  }
  .intro p {
    color: var(--grey);
    font-size: 0.95rem;
    max-width: 58ch;
    line-height: 1.5;
    margin: 0;
  }

  /* ---------- Form picker grid ---------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }

  .card {
    position: relative;
    border: 1px solid var(--stone);
    border-radius: 10px;
    background: var(--paper-raised);
    padding: 1.1rem 1.1rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .card:hover {
    border-color: var(--grey-soft);
    box-shadow: 0 2px 10px var(--shadow);
  }
  .card.selected {
    border-color: var(--accent);
    box-shadow: 0 2px 14px var(--shadow);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .card-id {
    font-size: 0.68rem;
    color: var(--grey);
    letter-spacing: 0.06em;
  }

  .card h3 {
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .card p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--grey);
    line-height: 1.45;
  }

  .card .fieldlist {
    margin: 0.2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: var(--grey-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
  }
  .card .fieldlist li::before {
    content: "·";
    margin-right: 0.35rem;
    color: var(--grey-soft);
  }
  .card .fieldlist li:first-child::before { content: none; }

  .checkbox {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 5px;
    border: 1.5px solid var(--grey-soft);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    transition: all 0.15s;
  }
  .card.selected .checkbox {
    background: var(--accent);
    border-color: var(--accent);
  }
  .checkbox svg {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0;
    transform: scale(0.7);
    transition: all 0.1s;
  }
  .card.selected .checkbox svg { opacity: 1; transform: scale(1); }

  .selected-bar {
    position: sticky;
    bottom: 1.25rem;
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 10px;
    padding: 0.85rem 1.1rem;
    box-shadow: 0 8px 24px var(--shadow);
  }
  .selected-bar .count {
    font-size: 0.88rem;
  }
  .selected-bar .count strong {
    font-family: 'FB Serif', Georgia, serif;
  }

  /* ---------- Buttons ---------- */

  .btn {
    border: none;
    border-radius: 7px;
    padding: 0.6rem 1.1rem;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.08s;
  }
  .btn:active { transform: translateY(1px); }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .btn-primary {
    background: var(--accent);
    color: var(--paper-raised);
  }
  .btn-primary:hover:not(:disabled) { opacity: 0.9; }

  .btn-ghost {
    background: transparent;
    color: var(--paper);
    border: 1px solid var(--grey-soft);
  }
  .btn-ghost:hover { border-color: var(--paper); }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--stone);
  }
  .btn-secondary:hover { border-color: var(--grey-soft); }

  .nav-row {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--stone);
  }

  /* ---------- Fill page ---------- */

  .fill-group {
    border: 1px solid var(--stone);
    border-radius: 10px;
    background: var(--paper-raised);
    margin-bottom: 1.1rem;
    overflow: hidden;
  }

  .fill-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    background: var(--stone-soft);
    border-bottom: 1px solid var(--stone);
  }
  .fill-group-head h3 {
    font-size: 1rem;
  }
  .fill-group-head .card-id { font-size: 0.68rem; }

  .fill-fields {
    padding: 1.1rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 1rem;
  }
  @media (max-width: 640px) {
    .fill-fields { grid-template-columns: 1fr; }
  }
  .fill-fields .span2 { grid-column: 1 / -1; }

  .field label {
    display: block;
    font-size: 0.76rem;
    color: var(--grey);
    margin-bottom: 0.35rem;
    letter-spacing: 0.01em;
  }
  .field label .req {
    color: var(--alert);
    margin-left: 0.15rem;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 6px;
    padding: 0.55rem 0.65rem;
  }
  .field textarea { resize: vertical; min-height: 4.2em; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--accent);
  }
  .field input:invalid:not(:placeholder-shown) {
    border-color: var(--alert);
  }

  .toolbar-row {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }

  /* ---------- Print page (screen preview) ---------- */

  .print-shell {
    background: var(--paper-raised);
    border: 1px solid var(--stone);
    border-radius: 10px;
    padding: 2.2rem 2.4rem;
    box-shadow: 0 2px 16px var(--shadow);
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.9rem;
    margin-bottom: 1.4rem;
  }
  .doc-head h2 {
    font-size: 1.5rem;
  }
  .doc-head .meta {
    text-align: right;
    font-size: 0.75rem;
    color: var(--grey);
  }
  .doc-head .meta .mono { color: var(--ink); }

  .doc-section {
    margin-bottom: 1.3rem;
    page-break-inside: avoid;
  }
  .doc-section h3 {
    font-size: 0.95rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--stone);
    margin-bottom: 0.6rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .doc-section h3 .card-id { font-weight: 400; }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem 1.2rem;
  }
  .doc-field {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px dotted var(--stone);
  }
  .doc-field.span2 { grid-column: 1 / -1; }
  .doc-field .k {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey);
  }
  .doc-field .v {
    font-size: 0.92rem;
  }
  .doc-field .v.empty {
    color: var(--grey-soft);
    font-style: italic;
  }

  .doc-foot {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--stone);
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--grey);
  }

  /* ---------- Print media ---------- */

  @media print {
    body { background: #fff; color: #000; }
    .masthead, .stepper, .nav-row, .toolbar-row, .no-print { display: none !important; }
    .shell { max-width: none; padding: 0; margin: 0; }
    .print-shell {
      border: none;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
    }
    .page { display: none; }
    .page.active { display: block; }
    .doc-head { border-bottom: 2px solid #000; }
    .doc-section h3, .doc-field { border-color: #999; }
    .doc-field .v.empty { color: #999; }
  }

  .print-status {
    font-size: 0.72rem;
    color: var(--grey);
    max-width: 26ch;
    text-align: right;
  }

  .footnote {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--stone);
    font-size: 0.72rem;
    color: var(--grey-soft);
    line-height: 1.6;
  }
</style>

<div class="shell">

  <header class="masthead">
    <div class="brand">
      <span class="mark">F</span>
      <h1>Formbundle</h1>
    </div>
    <span class="tag">Multi-form intake · proof of concept</span>
  </header>

  <nav class="stepper" id="stepper">
    <div class="step active" data-step="0">
      <span class="num">1</span>
      <span class="label"><strong>Select</strong><span>Choose forms</span></span>
    </div>
    <div class="step" data-step="1">
      <span class="num">2</span>
      <span class="label"><strong>Fill</strong><span>Enter details</span></span>
    </div>
    <div class="step" data-step="2">
      <span class="num">3</span>
      <span class="label"><strong>Print</strong><span>Combined page</span></span>
    </div>
  </nav>

  <!-- PAGE 0 — SELECT -->
  <section class="page active" id="page-select">
    <div class="intro">
      <h2>Select the forms you need</h2>
      <p>Pick any combination below. Your answers are combined into one fillable page, then rendered as a single printable document — no duplicate typing across forms.</p>
    </div>

    <div class="grid" id="formGrid"></div>

    <div class="selected-bar">
      <span class="count"><strong id="selCount">0</strong> of 7 forms selected</span>
      <button class="btn btn-ghost" id="goFill" disabled>Continue to fill-in →</button>
    </div>
  </section>

  <!-- PAGE 1 — FILL -->
  <section class="page" id="page-fill">
    <div class="intro">
      <h2>Fill in your details</h2>
      <p>Fields are grouped by the form they came from. Everything saves as you type.</p>
    </div>

    <div class="toolbar-row">
      <button class="btn btn-secondary" id="sampleFill">Fill with sample data</button>
      <button class="btn btn-secondary" id="clearFill">Clear all</button>
    </div>

    <div id="fillContainer"></div>

    <div class="nav-row">
      <button class="btn btn-secondary" id="backToSelect">← Back to selection</button>
      <button class="btn btn-primary" id="goPrint">Generate printable page →</button>
    </div>
  </section>

  <!-- PAGE 2 — PRINT -->
  <section class="page" id="page-print">
    <div class="intro no-print">
      <h2>Your combined document</h2>
      <p>This single page contains every field from every form you selected, ready to print or save as PDF.</p>
    </div>

    <div class="toolbar-row no-print" style="justify-content: space-between; align-items: center;">
      <button class="btn btn-secondary" id="backToFill">← Back to fill-in</button>
      <div style="display:flex; align-items:center; gap:0.7rem;">
        <span class="print-status mono" id="printStatus"></span>
        <button class="btn btn-primary" id="doPrint">🖨 Print / Save as PDF</button>
      </div>
    </div>

    <div class="print-shell" id="printOutput"></div>

    <div class="footnote no-print">
      Nothing is ever saved or sent anywhere — all data lives only in this browser tab's memory and disappears when the tab closes. Printing opens the document in a new tab using your browser's own print dialog, so you can choose a physical printer or "Save as PDF."
    </div>
  </section>

</div>

