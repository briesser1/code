    vendor_name: "Northline Supply Co.", vendor_contact: "Priya Nair", vendor_email: "priya@northlinesupply.com",
    vendor_terms: "Net 30", vendor_notes: "Preferred vendor for packaging materials",
    asset_tag: "AST-00231", asset_desc: "MacBook Pro 14\" (2025)", asset_borrower: "Jordan Pike",
    asset_return: "2026-11-27", asset_condition: "Minor scuff on lid, fully functional"
  };

  var state = {
    selected: JSON.parse(sessionStorage.getItem("fb_selected") || "[]"),
    values: JSON.parse(sessionStorage.getItem("fb_values") || "{}"),
    step: 0
  };

  function save() {
    sessionStorage.setItem("fb_selected", JSON.stringify(state.selected));
    sessionStorage.setItem("fb_values", JSON.stringify(state.values));
  }

  function formById(id) {
    for (var i = 0; i < FORMS.length; i++) if (FORMS[i].id === id) return FORMS[i];
    return null;
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  /* ---------- Render: Select page ---------- */

  function renderGrid() {
    var grid = document.getElementById("formGrid");
    grid.innerHTML = FORMS.map(function (f) {
      var isSel = state.selected.indexOf(f.id) !== -1;
      var fieldNames = f.fields.map(function (fl) { return fl.label; }).join("</li><li>");
      return (
        '<div class="card' + (isSel ? " selected" : "") + '" data-id="' + f.id + '" tabindex="0" role="checkbox" aria-checked="' + isSel + '">' +
          '<div class="card-top">' +
            '<div>' +
              '<div class="card-id mono">' + f.id + '</div>' +
              '<h3>' + escapeHtml(f.title) + '</h3>' +
            '</div>' +
            '<span class="checkbox">' +
              '<svg viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.2 11.7L13 4.5" stroke="var(--paper-raised)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
            '</span>' +
          '</div>' +
          '<p>' + escapeHtml(f.blurb) + '</p>' +
          '<ul class="fieldlist"><li>' + fieldNames + '</li></ul>' +
        '</div>'
      );
    }).join("");

    Array.prototype.forEach.call(grid.querySelectorAll(".card"), function (card) {
      card.addEventListener("click", function () { toggleForm(card.getAttribute("data-id")); });
      card.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggleForm(card.getAttribute("data-id")); }
      });
    });

    updateSelCount();
  }

  function toggleForm(id) {
    var idx = state.selected.indexOf(id);
    if (idx === -1) state.selected.push(id);
    else state.selected.splice(idx, 1);
    save();
    renderGrid();
  }

  function updateSelCount() {
    document.getElementById("selCount").textContent = state.selected.length;
    document.getElementById("goFill").disabled = state.selected.length === 0;
  }

  /* ---------- Render: Fill page ---------- */

  function renderFill() {
    var container = document.getElementById("fillContainer");
    container.innerHTML = state.selected.map(function (id) {
      var f = formById(id);
      if (!f) return "";
      var fieldsHtml = f.fields.map(function (fl) {
        var val = state.values[fl.key] || "";
        var reqAttr = fl.required ? " required" : "";
        var reqMark = fl.required ? '<span class="req">*</span>' : "";
        var inputHtml;
        if (fl.type === "textarea") {
          inputHtml = '<textarea data-key="' + fl.key + '"' + reqAttr + '>' + escapeHtml(val) + '</textarea>';
        } else if (fl.type === "select") {
          inputHtml = '<select data-key="' + fl.key + '"' + reqAttr + '>' +
            '<option value="">— Select —</option>' +
            fl.options.map(function (o) {
              return '<option value="' + escapeHtml(o) + '"' + (val === o ? " selected" : "") + '>' + escapeHtml(o) + '</option>';
            }).join("") +
            '</select>';
        } else {
          inputHtml = '<input type="' + fl.type + '" data-key="' + fl.key + '" value="' + escapeHtml(val) + '"' + reqAttr + '>';
        }
        return (
          '<div class="field' + (fl.span2 ? " span2" : "") + '">' +
            '<label>' + escapeHtml(fl.label) + reqMark + '</label>' +
            inputHtml +
          '</div>'
        );
      }).join("");

      return (
        '<div class="fill-group">' +
          '<div class="fill-group-head">' +
            '<h3>' + escapeHtml(f.title) + '</h3>' +
            '<span class="card-id mono">' + f.id + '</span>' +
          '</div>' +
          '<div class="fill-fields">' + fieldsHtml + '</div>' +
        '</div>'
      );
    }).join("");

    Array.prototype.forEach.call(container.querySelectorAll("[data-key]"), function (el) {
      el.addEventListener("input", function () {
        state.values[el.getAttribute("data-key")] = el.value;
        save();
      });
    });
  }

  /* ---------- Render: Print page ---------- */

  function renderPrint() {
    var out = document.getElementById("printOutput");
    var now = new Date();
    var dateStr = now.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" });
    var refId = "FB-" + now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0") + String(now.getDate()).padStart(2, "0") + "-" + Math.floor(Math.random() * 900 + 100);

    var sectionsHtml = state.selected.map(function (id) {
      var f = formById(id);
      if (!f) return "";
      var fieldsHtml = f.fields.map(function (fl) {
        var val = state.values[fl.key];
        var display = (val && String(val).trim()) ? escapeHtml(val) : "—";
        var emptyClass = (val && String(val).trim()) ? "" : " empty";
        return (
          '<div class="doc-field' + (fl.span2 ? " span2" : "") + '">' +
            '<span class="k">' + escapeHtml(fl.label) + '</span>' +
            '<span class="v' + emptyClass + '">' + display + '</span>' +
          '</div>'
        );
      }).join("");

      return (
        '<div class="doc-section">' +
          '<h3>' + escapeHtml(f.title) + ' <span class="card-id mono">' + f.id + '</span></h3>' +
          '<div class="doc-grid">' + fieldsHtml + '</div>' +
        '</div>'
      );
    }).join("");

    out.innerHTML =
      '<div class="doc-head">' +
        '<h2>Combined Submission</h2>' +
        '<div class="meta">Generated ' + dateStr + '<br>Reference <span class="mono">' + refId + '</span></div>' +
      '</div>' +
      sectionsHtml +
      '<div class="doc-foot">' +
        '<span>Formbundle proof-of-concept</span>' +
        '<span>' + state.selected.length + ' form' + (state.selected.length === 1 ? "" : "s") + ' combined</span>' +
      '</div>';
  }

  /* ---------- Navigation ---------- */

  function goToStep(n) {
    state.step = n;
    document.querySelectorAll(".page").forEach(function (p, i) {
      p.classList.toggle("active", i === n);
    });
    document.querySelectorAll(".step").forEach(function (s, i) {
      s.classList.toggle("active", i === n);
      s.classList.toggle("done", i < n);
    });
    if (n === 1) renderFill();
    if (n === 2) renderPrint();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.getElementById("goFill").addEventListener("click", function () { goToStep(1); });
  document.getElementById("backToSelect").addEventListener("click", function () { goToStep(0); });
  document.getElementById("goPrint").addEventListener("click", function () { goToStep(2); });
  document.getElementById("backToFill").addEventListener("click", function () { goToStep(1); });
  var PRINT_DOC_CSS =
    "@font-face{font-family:'FB Serif';src:local('Source Serif 4'),local('Georgia');}" +
    "*{box-sizing:border-box;}" +
    "body{margin:0;padding:32px 40px;background:#fff;color:#111;" +
    "font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;}" +
    "h2{font-family:'FB Serif','Source Serif 4',Georgia,serif;font-weight:600;margin:0;font-size:22px;}" +
    ".mono{font-family:'SF Mono','IBM Plex Mono',Menlo,Consolas,monospace;}" +
    ".doc-head{display:flex;justify-content:space-between;align-items:flex-start;" +
    "border-bottom:2px solid #111;padding-bottom:14px;margin-bottom:22px;}" +
    ".doc-head .meta{text-align:right;font-size:11px;color:#555;line-height:1.5;}" +
    ".doc-head .meta .mono{color:#111;}" +
    ".doc-section{margin-bottom:20px;page-break-inside:avoid;}" +
    ".doc-section h3{font-family:'FB Serif',Georgia,serif;font-weight:600;font-size:15px;" +
    "padding-bottom:5px;border-bottom:1px solid #ccc;margin:0 0 10px;" +
    "display:flex;justify-content:space-between;align-items:baseline;}" +
    ".doc-section h3 .mono{font-weight:400;font-size:11px;color:#555;}" +
    ".doc-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px;}" +
    ".doc-field{display:flex;flex-direction:column;gap:2px;padding-bottom:6px;" +
    "border-bottom:1px dotted #bbb;}" +
    ".doc-field.span2{grid-column:1/-1;}" +
    ".doc-field .k{font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:#666;}" +
    ".doc-field .v{font-size:14px;}" +
    ".doc-field .v.empty{color:#999;font-style:italic;}" +
    ".doc-foot{margin-top:30px;padding-top:12px;border-top:1px solid #ccc;" +
    "display:flex;justify-content:space-between;font-size:10px;color:#666;}" +
    "@page{margin:14mm;}" +
    "@media print{body{padding:0;}}";

  function buildPrintDocument() {
    var bodyHtml = document.getElementById("printOutput").innerHTML;
    return (
      "<!doctype html><html><head><meta charset='utf-8'>" +
      "<title>Combined Submission</title>" +
      "<style>" + PRINT_DOC_CSS + "</style>" +
      "</head><body>" + bodyHtml +
      "<script>window.onload=function(){setTimeout(function(){window.print();},150);};<\/script>" +
      "</body></html>"
    );
  }

  function handlePrintClick() {
    var statusEl = document.getElementById("printStatus");

    // Try opening a clean, unsandboxed tab first — this is the most reliable
    // path since the print dialog can be blocked inside an embedded viewer.
    var win = null;
    try {
      win = window.open("", "_blank");
    } catch (e) { win = null; }

    if (win && !win.closed) {
      try {
        win.document.open();
        win.document.write(buildPrintDocument());
        win.document.close();
        statusEl.textContent = "Opened in a new tab for printing.";
        return;
      } catch (e) {
        // fall through to direct print attempt
      }
    }

    // Fallback: try printing this document directly.
    try {
      window.print();
      statusEl.textContent = "";
    } catch (e) {
      statusEl.textContent = "Pop-ups blocked — allow pop-ups for this site, or use your browser's own Print (Ctrl/Cmd+P).";
    }
  }

  document.getElementById("doPrint").addEventListener("click", handlePrintClick);

  document.getElementById("sampleFill").addEventListener("click", function () {
    state.selected.forEach(function (id) {
      var f = formById(id);
      f.fields.forEach(function (fl) {
        if (SAMPLE[fl.key] !== undefined) state.values[fl.key] = SAMPLE[fl.key];
      });
    });
    save();
    renderFill();
  });

  document.getElementById("clearFill").addEventListener("click", function () {
    state.selected.forEach(function (id) {
      var f = formById(id);
      f.fields.forEach(function (fl) { delete state.values[fl.key]; });
    });
    save();
    renderFill();
  });

  renderGrid();
  goToStep(state.step);
})();
</script>
